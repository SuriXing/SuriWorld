---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import { fmtDate } from '../lib/format';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);

const years = [...new Set(posts.map((p) => p.data.date.getFullYear()))]
  .sort((a, b) => b - a)
  .map((year) => ({
    year,
    items: posts.filter((p) => p.data.date.getFullYear() === year),
  }));
---

<Base>
  {
    years.map(({ year, items }) => (
      <section class="year">
        <h2>{year}</h2>
        <ul class="postlist">
          {items.map((post) => (
            <li>
              <a href={`/blog/posts/${post.id}/`}>
                <span class="posttitle">{post.data.title}</span>
                <span class="postmeta">
                  {fmtDate(post.data.date)} · {post.data.category}
                </span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    ))
  }
</Base>
