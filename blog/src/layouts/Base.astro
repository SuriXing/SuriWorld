---
import '@fontsource-variable/inter';
import '@fontsource-variable/fraunces';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title,
  description = 'Coding journey, math, and small things I build, by Suri.',
} = Astro.props;
const pageTitle = title ? `${title} - Suri's Blog` : "Suri's Blog";
// Absolute paths below carry the /blog base from astro.config.mjs.
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link
      rel="alternate"
      type="application/rss+xml"
      title="Suri's Blog"
      href="/blog/rss.xml"
    />
    <link rel="sitemap" href="/blog/sitemap-index.xml" />
  </head>
  <body>
    <div class="shell">
      <header class="site-head">
        <p class="wordmark"><a href="/blog/">Suri's Blog</a></p>
        <p class="tagline">
          Learning to code in public: C, math competitions, and small shipped
          things.
        </p>
        <nav class="site-nav" aria-label="Site">
          <a href="/blog/">Posts</a>
          <a href="/blog/rss.xml">RSS</a>
          <a href="/">Main site</a>
        </nav>
      </header>
      <slot />
      <footer class="site-foot">
        <span>© {new Date().getFullYear()} Suri Xing</span>
        <span>
          <a href="/blog/rss.xml">RSS</a>
          <span aria-hidden> · </span>
          <a href="/">Main site</a>
        </span>
      </footer>
    </div>
  </body>
</html>
